# Kopieer naar .dev.vars (staat in .gitignore) en vul lokaal in. Zet nooit echte waarden in dit voorbeeldbestand.
# SUPABASE_URL en OWNER_EMAIL staan als gewone (niet-geheime) vars al in wrangler.jsonc.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET=
# Pushmelding naar de eigenaar via Pushover (pushover.net); zonder deze twee gebeurt er niets:
PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=
# Inloggen voor /admin/orders (tijdelijk tot eetbuyt.nl aan Cloudflare hangt en Cloudflare Access
# met een pad-policy kan, zie ontwerp §9/§16). Eén account per persoon, elk met eigen wachtwoord
# en 2FA-sleutel (via /admin/setup-2fa, achter de login). Voorbeeld:
# ADMIN_ACCOUNTS=[{"name":"Skip","password":"...","totp":"..."},{"name":"Partner","password":"...","totp":"..."}]
ADMIN_ACCOUNTS=
# Los van ieders wachtwoord: ondertekent alleen de sessiecookie. Zelf een willekeurige tekst kiezen.
ADMIN_SESSION_SECRET=
# Bevestigingsmail aan de klant via Resend (resend.com), verzonden vanaf mail.eetbuyt.nl;
# zonder deze sleutel gebeurt er niets:
RESEND_API_KEY=
# Fase 2:
# MOLLIE_API_KEY=
