{
  // Cloudflare Worker met statische bestanden voor eetbuyt.nl (branch cloudflare-supabase).
  // Geheimen (SUPABASE_SERVICE_ROLE_KEY, TURNSTILE_SECRET, ...) horen hier NIET; zie .dev.vars.example en supabase/README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Moet overeenkomen met de Worker-naam die al in het Cloudflare-dashboard is aangemaakt.
  "name": "buyt-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Alleen public/ wordt geserveerd: worker/, supabase/, docs/, netlify/ en de configbestanden
    // staan hier fysiek buiten, in plaats van te vertrouwen op .assetsignore (zie ontwerp §4/§16).
    "directory": "public",
    "binding": "ASSETS",
    // De Worker draait voor /api/* en /admin/* (dat laatste achter een wachtwoord, zie
    // worker/lib/adminAuth.js); alle andere paden komen rechtstreeks uit de bestanden.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // Alleen niet-geheime waarden. Zonder dit blok zet "wrangler deploy" bij elke nieuwe build de
  // gewone variabelen terug op niets (secrets blijven wel staan, die worden apart beheerd) — dat
  // verklaart waarom SUPABASE_URL/OWNER_EMAIL steeds uit het dashboard leken te verdwijnen.
  "vars": {
    "SUPABASE_URL": "https://hfaaufsdonsitjfwzvrk.supabase.co",
    "OWNER_EMAIL": "eetbuyt@gmail.com",
    // VERKOOPSCHAKELAAR. "false": de productenpagina is geblurd ("Binnenkort bestellen mogelijk") en /api/order weigert
    // iedereen behalve ingelogde beheerders (/admin/login). "true": de winkel is open zoals voorheen.
    // Openzetten bij livegang: zie docs/verkoop-openzetten.md.
    "SALES_OPEN": "false"
  },
  "observability": { "enabled": true }
}
